<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VíThôngMinh — Quản lý chi tiêu gia đình & cá nhân</title>
  <meta name="description" content="Ứng dụng quản lý thu chi, ngân sách gia đình và nhóm đơn giản, an toàn." />
  <link rel="stylesheet" href="./output.css" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-surface font-sans text-ink antialiased">

  <!-- SECTION 1: HEADER & NAVIGATION -->
  <header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#" class="flex items-center gap-2">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 font-display text-lg font-extrabold text-white shadow-sm">V</span>
        <span class="font-display text-xl font-extrabold tracking-tight text-ink">VíThôngMinh</span>
      </a>

      <nav aria-label="Điều hướng chính" class="hidden md:block">
        <ul class="flex items-center gap-8 text-sm font-semibold text-muted">
          <li><a href="#doi-tuong" class="transition hover:text-brand-600">Đối tượng</a></li>
          <li><a href="#tinh-nang" class="transition hover:text-brand-600">Tính năng</a></li>
          <li><a href="#cach-hoat-dong" class="transition hover:text-brand-600">Cách hoạt động</a></li>
          <li><a href="#so-lieu" class="transition hover:text-brand-600">Số liệu</a></li>
          <li><a href="#danh-gia" class="transition hover:text-brand-600">Đánh giá</a></li>
          <li><a href="#bang-gia" class="transition hover:text-brand-600">Bảng giá</a></li>
          <li><a href="#cau-hoi" class="transition hover:text-brand-600">Hỏi đáp</a></li>
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <a href="#cta" class="btn btn-ghost hidden sm:inline-flex">Đăng nhập</a>
        <a href="#cta" class="btn btn-primary">Dùng miễn phí</a>
      </div>
    </div>
  </header>

  <main id="main-content">

    <!-- SECTION 2: HERO -->
    <section class="section text-center" aria-labelledby="hero-title">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Giải pháp tài chính 2026</p>
        <h1 id="hero-title" class="mt-4 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Quản lý chi tiêu gia đình <span class="text-brand-600">không còn là gánh nặng</span>
        </h1>
        <p class="mt-6 text-lg text-muted sm:text-xl">
          Theo dõi thu chi, chia tiền sòng phẳng và lập kế hoạch tiết kiệm cùng người thân chỉ trên một ứng dụng duy nhất.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row sm:items-center">
          <a href="#cta" class="btn btn-primary text-base">Trải nghiệm miễn phí ngay</a>
          <a href="#cach-hoat-dong" class="btn btn-ghost text-base">Xem hướng dẫn (2 phút)</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: DẢI ĐỐI TƯỢNG SỬ DỤNG (Nhiệm vụ 2 - Flexbox flex-wrap) -->
    <section id="doi-tuong" class="border-y border-line bg-white py-10" aria-labelledby="target-title">
      <div class="mx-auto max-w-6xl px-5 text-center">
        <h2 id="target-title" class="text-xs font-bold uppercase tracking-widest text-muted">Dành cho mọi nhu cầu quản lý tài chính</h2>
        <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-sm font-semibold text-ink sm:text-base">
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-brand-500"></span> Cá nhân đi làm</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-brand-500"></span> Gia đình trẻ</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-brand-500"></span> Sinh viên ở ghép</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-brand-500"></span> Nhóm đi du lịch</li>
        </ul>
      </div>
    </section>

    <!-- SECTION 4: LƯỚI TÍNH NĂNG (Nhiệm vụ 2 - Responsive Grid & SVG) -->
    <section id="tinh-nang" class="section" aria-labelledby="features-title">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Tính năng nổi bật</p>
        <h2 id="features-title" class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Mọi công cụ bạn cần để làm chủ dòng tiền
        </h2>
      </div>

      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <li class="card">
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Ghi chép siêu tốc</h3>
          <p class="mt-2 text-muted">Nhập khoản chi chỉ trong 3 giây. Phân loại tự động theo Tiền chợ, Hóa đơn hay Con cái.</p>
        </li>

        <li class="card">
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Ví chung gia đình</h3>
          <p class="mt-2 text-muted">Cùng vợ/chồng quản lý ngân sách sinh hoạt chung. Minh bạch và cập nhật theo thời gian thực.</p>
        </li>

        <li class="card">
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Cảnh báo chi tiêu</h3>
          <p class="mt-2 text-muted">Nhận thông báo ngay khi ngân sách danh mục chạm ngưỡng 80% để chủ động điều chỉnh.</p>
        </li>
      </ul>
    </section>

    <!-- SECTION BTVN: CÁCH HOẠT ĐỘNG (Bài tập thêm) -->
    <section id="cach-hoat-dong" class="section border-t border-line bg-white" aria-labelledby="how-it-works-title">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Quy trình đơn giản</p>
        <h2 id="how-it-works-title" class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
          3 bước để làm chủ tài chính
        </h2>
      </div>

      <ol class="mt-12 grid gap-8 md:grid-cols-3">
        <li class="card relative">
          <span class="font-display text-4xl font-extrabold text-brand-600">01</span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Tạo tài khoản</h3>
          <p class="mt-2 text-muted">Đăng ký nhanh chóng chỉ trong 1 phút, không cần thẻ tín dụng hay thủ tục rườm rà.</p>
        </li>
        <li class="card relative">
          <span class="font-display text-4xl font-extrabold text-brand-600">02</span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Ghi chép thu chi</h3>
          <p class="mt-2 text-muted">Thêm ví chung/ví riêng và ghi lại các khoản thu chi hàng ngày cực đơn giản.</p>
        </li>
        <li class="card relative">
          <span class="font-display text-4xl font-extrabold text-brand-600">03</span>
          <h3 class="mt-4 font-display text-xl font-bold text-ink">Theo dõi báo cáo</h3>
          <p class="mt-2 text-muted">Xem biểu đồ trực quan tự động để biết chính xác dòng tiền đang đi về đâu.</p>
        </li>
      </ol>
    </section>

    <!-- SECTION 5: KHỐI SỐ LIỆU (Nhiệm vụ 3 - Kỹ thuật order-2 & divide-x) -->
    <section id="so-lieu" class="border-y border-line bg-brand-600 py-16 text-white" aria-labelledby="solieu-title">
      <div class="mx-auto max-w-6xl px-5">
        <h2 id="solieu-title" class="sr-only">Số liệu ấn tượng</h2>
        <dl class="grid grid-cols-2 gap-8 md:grid-cols-4 md:divide-x md:divide-brand-500">
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 text-sm text-brand-100">Người dùng tin tưởng</dt>
            <dd class="order-1 font-display text-4xl font-extrabold sm:text-5xl">50.000+</dd>
          </div>
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 text-sm text-brand-100">Giao dịch ghi chép</dt>
            <dd class="order-1 font-display text-4xl font-extrabold sm:text-5xl">2.5M+</dd>
          </div>
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 text-sm text-brand-100">Tiết kiệm trung bình</dt>
            <dd class="order-1 font-display text-4xl font-extrabold sm:text-5xl">18%</dd>
          </div>
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 text-sm text-brand-100">Đánh giá hài lòng</dt>
            <dd class="order-1 font-display text-4xl font-extrabold sm:text-5xl">4.9/5</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- SECTION 6: ĐÁNH GIÁ CẢM NHẬN (Nhiệm vụ 3 - Semantic markup) -->
    <section id="danh-gia" class="section" aria-labelledby="reviews-title">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Người thật việc thật</p>
        <h2 id="reviews-title" class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Được tin dùng bởi hơn 50.000+ gia đình
        </h2>
      </div>

      <ul class="mt-12 grid gap-8 md:grid-cols-2">
        <li class="card">
          <figure class="flex h-full flex-col justify-between">
            <blockquote class="italic text-muted">
              "Từ ngày dùng ứng dụng, vợ chồng mình không còn tranh cãi về khoản tiền sinh hoạt cuối tháng. Việc chia ví giúp hai vợ chồng rất minh bạch."
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-bold text-brand-700">NT</div>
              <div>
                <span class="block font-bold text-ink">Nguyễn Thanh B</span>
                <cite class="text-xs text-muted not-italic">Nội trợ · TP. Hồ Chí Minh</cite>
              </div>
            </figcaption>
          </figure>
        </li>

        <li class="card">
          <figure class="flex h-full flex-col justify-between">
            <blockquote class="italic text-muted">
              "Tính năng chia tiền nhóm khi đi du lịch quá tuyệt vời. Không còn cảnh ngồi tính toán sổ sách phức tạp sau mỗi chuyến đi nữa."
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-bold text-brand-700">HA</div>
              <div>
                <span class="block font-bold text-ink">Hoàng Anh K</span>
                <cite class="text-xs text-muted not-italic">Lập trình viên · Hà Nội</cite>
              </div>
            </figcaption>
          </figure>
        </li>
      </ul>
    </section>

    <!-- SECTION 7: BẢNG GIÁ (Nhiệm vụ 4 - Grid items-stretch & mt-auto) -->
    <section id="bang-gia" class="section border-t border-line bg-white" aria-labelledby="pricing-title">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Bảng giá minh bạch</p>
        <h2 id="pricing-title" class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Lựa chọn gói phù hợp với bạn
        </h2>
      </div>

      <ul class="mt-12 grid items-stretch gap-6 lg:grid-cols-3">
        <!-- Thẻ 1 -->
        <li class="card flex h-full flex-col">
          <h3 class="font-display text-xl font-bold text-ink">Cá nhân</h3>
          <p class="mt-1 text-xs text-muted">Dành cho người mới bắt đầu quản lý tài chính.</p>
          <p class="mt-6 font-display text-4xl font-extrabold text-ink">Miễn phí<span class="text-sm font-normal text-muted">/trọn đời</span></p>
          <ul class="mt-6 space-y-3 text-sm text-muted">
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> 1 tài khoản cá nhân</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Ghi chép thu chi không giới hạn</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Báo cáo cơ bản hàng tháng</li>
          </ul>
          <a href="#cta" class="btn btn-ghost mt-auto w-full">Bắt đầu ngay</a>
        </li>

        <!-- Thẻ 2 (Nổi bật) -->
        <li class="card relative flex h-full flex-col ring-2 ring-brand-600 shadow-lg">
          <span class="badge absolute -top-3 left-6 rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">Được chọn nhiều nhất</span>
          <h3 class="font-display text-xl font-bold text-ink">Gia đình</h3>
          <p class="mt-1 text-xs text-muted">Dành cho vợ chồng cùng quản lý tài chính.</p>
          <p class="mt-6 font-display text-4xl font-extrabold text-brand-600">49.000 ₫<span class="text-sm font-normal text-muted">/tháng</span></p>
          <ul class="mt-6 space-y-3 text-sm text-muted">
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Tối đa 6 thành viên</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Tạo nhiều Ví chung/Ví riêng</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Cảnh báo vượt hạn mức thông minh</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Xuất dữ liệu Excel/PDF</li>
          </ul>
          <a href="#cta" class="btn btn-primary mt-auto w-full">Dùng thử 14 ngày</a>
        </li>

        <!-- Thẻ 3 -->
        <li class="card flex h-full flex-col">
          <h3 class="font-display text-xl font-bold text-ink">Nhóm & Cửa hàng</h3>
          <p class="mt-1 text-xs text-muted">Dành cho nhóm bạn đi chơi hoặc kinh doanh nhỏ.</p>
          <p class="mt-6 font-display text-4xl font-extrabold text-ink">99.000 ₫<span class="text-sm font-normal text-muted">/tháng</span></p>
          <ul class="mt-6 space-y-3 text-sm text-muted">
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Tối đa 20 thành viên</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Tự động chia tiền sòng phẳng</li>
            <li class="flex items-center gap-2"><span class="text-brand-600">✔</span> Phân quyền quản trị nâng cao</li>
          </ul>
          <a href="#cta" class="btn btn-ghost mt-auto w-full">Đăng ký ngay</a>
        </li>
      </ul>
    </section>

    <!-- SECTION 8: CÂU HỎI THƯỜNG GẶP (Nhiệm vụ 5 - Lưới tùy chỉnh lg:grid-cols-[1fr_1.4fr]) -->
    <section id="cau-hoi" class="section" aria-labelledby="faq-title">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="eyebrow">Giải đáp thắc mắc</p>
          <h2 id="faq-title" class="mt-3 font-display text-3xl font-extrabold text-ink sm:text-4xl">
            Câu hỏi thường gặp
          </h2>
          <p class="mt-4 text-muted">Mọi thắc mắc của bạn về tính năng và độ bảo mật đều được giải đáp chi tiết tại đây.</p>
        </div>

        <dl class="space-y-6">
          <div class="card">
            <dt class="font-display text-lg font-bold text-ink">Tôi có cần liên kết tài khoản ngân hàng không?</dt>
            <dd class="mt-2 text-muted">Hoàn toàn không. VíThôngMinh cho phép bạn chủ động nhập liệu thủ công để đảm bảo an toàn thông tin cá nhân tuyệt đối.</dd>
          </div>
          <div class="card">
            <dt class="font-display text-lg font-bold text-ink">Ứng dụng có thể dùng trên nhiều thiết bị không?</dt>
            <dd class="mt-2 text-muted">Có, dữ liệu được đồng bộ hóa tức thì giữa điện thoại Android, iOS và nền tảng Web.</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- SECTION 9: CALL TO ACTION -->
    <section id="cta" class="section border-t border-line bg-brand-50" aria-labelledby="cta-title">
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="cta-title" class="font-display text-3xl font-extrabold text-ink sm:text-4xl">
          Bắt đầu quản lý tài chính hiệu quả ngay hôm nay
        </h2>
        <p class="mt-4 text-muted">Đăng ký tài khoản miễn phí và trải nghiệm sự thay đổi tích cực trong quản lý chi tiêu.</p>
        <div class="mt-8 flex justify-center">
          <a href="#" class="btn btn-primary text-base">Tạo tài khoản miễn phí</a>
        </div>
      </div>
    </section>

  </main>

  <!-- SECTION 10: FOOTER (Nhiệm vụ 5 - Footer 4 cột chuẩn Semantic) -->
  <footer class="border-t border-line bg-white py-12 text-sm text-muted">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Cột 1 -->
      <div>
        <a href="#" class="flex items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 font-display text-base font-extrabold text-white">V</span>
          <span class="font-display text-lg font-extrabold text-ink">VíThôngMinh</span>
        </a>
        <p class="mt-4 text-xs leading-relaxed">Phần mềm quản lý chi tiêu gia đình & cá nhân hàng đầu, an toàn và dễ sử dụng.</p>
      </div>

      <!-- Cột 2 -->
      <nav aria-labelledby="footer-product">
        <h3 id="footer-product" class="font-bold text-ink">Sản phẩm</h3>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href="#tinh-nang" class="transition hover:text-brand-600">Tính năng</a></li>
          <li><a href="#bang-gia" class="transition hover:text-brand-600">Bảng giá</a></li>
          <li><a href="#cach-hoat-dong" class="transition hover:text-brand-600">Quy trình</a></li>
        </ul>
      </nav>

      <!-- Cột 3 -->
      <nav aria-labelledby="footer-support">
        <h3 id="footer-support" class="font-bold text-ink">Hỗ trợ</h3>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href="#cau-hoi" class="transition hover:text-brand-600">Hỏi đáp (FAQ)</a></li>
          <li><a href="#" class="transition hover:text-brand-600">Điều khoản dịch vụ</a></li>
          <li><a href="#" class="transition hover:text-brand-600">Chính sách bảo mật</a></li>
        </ul>
      </nav>

      <!-- Cột 4 -->
      <div>
        <h3 class="font-bold text-ink">Tác giả</h3>
        <p class="mt-3 text-xs">Phạm Huỳnh Phước</p>
        <p class="mt-1 text-xs text-muted">Đại học Mở TP.HCM (HCMCOU)</p>
      </div>
    </div>
  </footer>

</body>
</html>